# Main web app automatically reads the repository-root .env.
# Copy this file to .env ONCE; existing process environment takes precedence.
# Never commit actual credentials. Missing keys allow page preview, not inference.
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://detect.roboflow.com
TONGJI_AGENT_API_KEY=
TONGJI_AGENT_BASE_URL=https://agent.tongji.edu.cn/api/proxy
TONGJI_AGENT_USER_ID=tj-toothai

# Empty TJT_DATA_DIR uses <repository>/var; relative paths resolve from repo root.
TJT_DATA_DIR=
TJT_FONT_PATH=
TJT_HOST=127.0.0.1
TJT_PORT=5000

# Set the public HTTPS origin for a deployment; leave empty for local requests.
PUBLIC_BASE_URL=
# Browser-visible URL. Use /v1/create-qr-code/ behind a same-origin proxy.
QRCODE_API_URL=http://127.0.0.1:16666/v1/create-qr-code/

# qrcode-server and historical scripts do NOT load this .env automatically.
# Configure their optional variables in the shell or service manager:
# QRCODE_BG_PATH, QRCODE_FONT_PATH, QRCODE_HOST, QRCODE_PORT
